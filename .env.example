# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Never commit production credentials to Git)
MONGO_URI=mongodb://127.0.0.1:27017/exam_allocation

# Security & JWT Configuration
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret
JWT_EXPIRES_IN=2h

# Email Notification Service (SMTP)
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-an-app-specific-password

# Client URL for CORS and Password Reset Links
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
